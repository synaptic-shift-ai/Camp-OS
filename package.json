{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:watch": "vitest bench",
    "type-check": "tsc --noEmit",
    "gen:db": "npx supabase gen types typescript --linked > src/contracts/db.ts && echo '✅ Generated database types in src/contracts/db.ts'",
    "gen:types": "npm run gen:db",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "check": "npm run type-check && npm run lint",
    "check:full": "npm run gen:db && npm run check && npm run build",
    "prepare": "husky || true",
    "test:email": "tsx scripts/test-email.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "seed:analytics": "node scripts/run-seed-data.js",
    "generate:module": "npx tsx scripts/generate-module.ts"
  },
