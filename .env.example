# App Configuration
# Your application URL (required for OAuth redirects)
NEXT_PUBLIC_APP_URL=https://localhost:3000
NEXT_PUBLIC_BASE_URL=https://localhost:3000

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Backup / Restore
# Direct Postgres connection strings — get from:
#   Supabase Dashboard → Project → Settings → Database → Connection string (URI mode, port 5432)
# DB_SOURCE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# DB_TARGET_URL=postgresql://postgres:<password>@db.<backup-project-ref>.supabase.co:5432/postgres
#
# Optional: directory to store backup files (default: ./backups)
# DB_BACKUP_DIR=backups

# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe Connect (for onboarding payment processing setup)
# Create a Connect application in Stripe: https://dashboard.stripe.com/settings/applications
# Get your client ID from the Connect settings
NEXT_PUBLIC_STRIPE_CLIENT_ID=ca_your-stripe-connect-client-id

# Stripe Webhook Secret
# Create a webhook endpoint in Stripe dashboard pointing to /api/webhooks/stripe
# Get the signing secret from: https://dashboard.stripe.com/webhooks
# For local testing, use: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Email sender address (must be verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMTP Configuration for emails
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-smtp-from-email # Sender address(e.g. noreply@yourdomain.com)
# Set to true for port 465
# SMTP_SECURE=false


# Sentry Error Tracking Configuration
# Get your DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry organization and project (for source map uploads)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token

# Optional: Enable Sentry in development (disabled by default)
# NEXT_PUBLIC_SENTRY_ENABLED=true
# SENTRY_ENABLED=true

# Automation Engine — Set to 'true' to activate the automation pipeline
ENABLE_PERSISTENT_EVENT_BUS=true
